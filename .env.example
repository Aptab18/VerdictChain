# Copy this file to .env and fill in ONE provider's key.
# .env is gitignored -- never commit a real key.

# --- Gemini (Google AI Studio) -- https://aistudio.google.com/apikey ---------
GEMINI_API_KEY=your_gemini_key_here
# GEMINI_MODEL=gemini-3.5-flash-lite

# --- or Groq -- https://console.groq.com/keys --------------------------------
# Groq keys start with "gsk_". A non-gsk_ value here is treated as a Gemini key.
# GROQ_API_KEY=gsk_your_key_here
# GROQ_MODEL=openai/gpt-oss-120b

# Force a provider instead of auto-detecting from the key: "gemini" or "groq"
# LLM_PROVIDER=gemini

# How many of the highest-risk incidents get an LLM-written explanation.
# Free tiers cap tokens per minute, so this is a budget, not a limit on detection.
# LLM_MAX_INCIDENTS=8
